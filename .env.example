# npm run demo needs no secrets and uses memory-only sample data.
# Production requires explicit settings; use Secret Manager on GCP.
APP_MODE=production
NEXT_PUBLIC_APP_MODE=production
APP_ORIGIN=https://nft.vgr.cx
MARKETING_ORIGIN=https://nft.vgr.cx
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/nftech
NFT_EMBEDDED_DB=false
ENS_SIMULATED=false
# Sign-in reads the public ID from /api/auth/config at runtime. The secret stays server-only.
# NEXT_PUBLIC_PRIVY_APP_ID is an optional legacy fallback; it is not required at build time.
PRIVY_APP_ID=cmugv9qec007k0cjqls8jvrw2
PRIVY_APP_SECRET=
KMS_KEY_RESOURCE=
CHECKOUT_ENABLED=false
PAYMENT_PROVIDER=disabled
PAYMENT_RECIPIENT=
PAYMENT_RPC_URL=https://evmrpc.0g.ai
# Base USDC source; destination is native 0G. Destination RPC must support
# debug_traceTransaction with callTracer for relayed fills. Treasury must be an EOA.
PAYMENT_SOURCE_RPC_URL=
PAYMENT_CONFIRMATIONS=12
PAYMENT_SOURCE_CONFIRMATIONS=12
TOKENFLIGHT_INTEGRATOR_ID=
# Set PAYMENT_PROVIDER=0g-pay and CHECKOUT_ENABLED=true only after configuring the route.
ENS_ENABLED=false
# Existing names: Ethereum mainnet (1) or Sepolia (11155111). ENSv2 namespace stays Sepolia.
ENS_CHAIN_ID=1
ENS_MAINNET_RPC_URL=
ENS_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ENS_SEPOLIA_RPC_URL=
ENS_WRITE_ENABLED=false
ENROLLMENT_OPEN=true
MEMBER_DIRECTORY_ENABLED=true
NOW_ENABLED=true
SUPPORT_EMAIL=
SELLER_NAME=
# Set only behind a proxy that overwrites incoming client-provided IP headers.
TRUST_PROXY=false

# GCP: a JSON map of allowed server env names to Secret Manager version resources.
# Runtime access uses the attached service account; never commit secret values.
SECRET_ENV_MAP=

# ENSv2 trips, tables and concierge (Sepolia beta). Run npm run ens:bootstrap once to fill the addresses.
ENS_PARENT_NAME=
ENS_PARENT_REGISTRY=
ENS_CITY_REGISTRY_TOKYO=
ENS_APP_RESOLVER=
# Two different keys: the operator registers names and writes member records, the concierge holds
# setter roles for friendship.now and friendship.table only. Secret Manager in production.
ENS_OPERATOR_PRIVATE_KEY=
ENS_CONCIERGE_PRIVATE_KEY=
# World ID (IDKit v4) at trip activation. Developer Portal: app id, RP id, RP signing key.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION_TRIP=trip-activate
WORLD_ENVIRONMENT=production
# Hackathon demo: let a production build use the IDKit staging simulator (simulator.worldcoin.org).
WORLD_ALLOW_STAGING=false
# Concierge approvals: "session" (IDKit sessions, default) or "agents" (World ID for Agents OIDC,
# required for the ETHGlobal "World ID for Agents" prize). Register the client at
# https://sandbox.auth.world.org/portal with redirect <APP_ORIGIN>/api/world/agent/callback.
WORLD_APPROVALS=session
WORLD_AGENTS_ISSUER=https://sandbox.auth.world.org
WORLD_AGENTS_CLIENT_ID=
WORLD_AGENTS_CLIENT_SECRET=
WORLD_AGENTS_REDIRECT_URI=
# rules (deterministic, shipped) or custom (src/server/ens-world/concierge/custom-brain.ts).
CONCIERGE_BRAIN=rules
# Bill splits are direct wallet-signed native USDC transfers, independent of ENSv2's network.
SPLIT_NETWORK=base
SPLIT_RPC_URL=
# Keep a network-specific RPC when old unpaid obligations exist after switching networks.
SPLIT_BASE_RPC_URL=
SPLIT_ETHEREUM_RPC_URL=
